<Window x:Class="BOTBUDDY_CYBERSECURITY_CHATBOT.CHATBOT_INTERFACE"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyber Bot AI - Security Chatbot"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="EyeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="HotPink"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#20FF66B2"/>
                                <Setter Property="Foreground" Value="#FF66B2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF1493"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" Padding="4,2" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#20FF66B2"/>
                                <Setter Property="Foreground" Value="#FF66B2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubmitButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF1493"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF66B2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AvatarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="30" BorderThickness="2" BorderBrush="#FF1493">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#20FF1493"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF1493"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF66B2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FavoriteTopicStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#FF1493"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!-- Glow effect for ASCII art -->
        <DropShadowEffect x:Key="GlowEffect" Color="#FF1493" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>

        <!-- INVISIBLE SCROLLBAR STYLE -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="0"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- SPLASH PANEL -->
        <Grid x:Name="SplashOverlay" Visibility="Visible">
            <!-- Background image -->
            <Grid.Background>
                <ImageBrush ImageSource="/Image/mybotbackground.png" Stretch="UniformToFill" Opacity="0.5"/>
            </Grid.Background>

            <!-- ASCII Art Layer with SOLID BLACK background card -->
            <Grid x:Name="AsciiLayer" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                <!-- Solid black card behind ASCII art -->
                <Border Background="#000000" 
                CornerRadius="20" 
                Padding="50,40,50,40"
                BorderBrush="#FF1493"
                BorderThickness="2"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Opacity="1.0">

                    <Border.Effect>
                        <DropShadowEffect Color="#FF1493" BlurRadius="25" ShadowDepth="0" Opacity="0.6"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- CYBER text - solid, bright colors -->
                        <TextBlock x:Name="TxtCyber" 
                           FontFamily="Consolas" 
                           FontWeight="Bold" 
                           FontSize="12"
                           TextAlignment="Center" 
                           HorizontalAlignment="Center" 
                           TextWrapping="NoWrap"
                           xml:space="preserve" 
                           LineStackingStrategy="BlockLineHeight" 
                           LineHeight="12"
                           SnapsToDevicePixels="True" 
                           UseLayoutRounding="True"
                           TextOptions.TextFormattingMode="Display" 
                           TextOptions.TextRenderingMode="Aliased"
                           Opacity="1.0"
                           Foreground="#FF3333"/>

                        <!-- BOT text - solid, bright colors -->
                        <TextBlock x:Name="TxtBot" 
                           FontFamily="Consolas" 
                           FontWeight="Bold" 
                           FontSize="14"
                           Margin="0,10,0,0" 
                           TextAlignment="Center" 
                           HorizontalAlignment="Center"
                           TextWrapping="NoWrap" 
                           xml:space="preserve" 
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="14" 
                           SnapsToDevicePixels="True" 
                           UseLayoutRounding="True"
                           TextOptions.TextFormattingMode="Display" 
                           TextOptions.TextRenderingMode="Aliased"
                           Opacity="1.0"
                           Foreground="#FF44FF"/>

                        <!-- Tagline text - solid, shimmering -->
                        <TextBlock x:Name="TxtTagline" 
                           FontFamily="Consolas" 
                           FontWeight="Bold"
                           TextAlignment="Center" 
                           HorizontalAlignment="Center" 
                           Margin="0,25,0,0"
                           Opacity="0" 
                           TextWrapping="NoWrap" 
                           xml:space="preserve"
                           SnapsToDevicePixels="True" 
                           UseLayoutRounding="True"
                           TextOptions.TextFormattingMode="Display" 
                           TextOptions.TextRenderingMode="Aliased"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- MAIN INTERFACE -->
        <Grid x:Name="MainInterface" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <Grid.Effect>
                <BlurEffect x:Name="ChatBlur" Radius="0"/>
            </Grid.Effect>

            <!-- MAIN CHAT AREA -->
            <Border Grid.Column="0" Background="#0D0D0D">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="70"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Border Grid.Row="0" Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
                        <Grid Margin="20,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="LogoText" Text="C  Y  B  E  R   B  O  T   AI"
                                           FontSize="22" FontWeight="Bold" FontFamily="Consolas"
                                           Foreground="#FF1493" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ChatUsernameText" FontSize="12" FontFamily="Consolas"
                                           Foreground="#666" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnAvatar" Style="{StaticResource AvatarButtonStyle}"
                                    Width="50" Height="50" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Click="BtnAvatar_Click">
                                <Grid>
                                    <Viewbox x:Name="AvatarDefaultIcon" Width="24" Height="24">
                                        <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" Fill="#888888"/>
                                    </Viewbox>
                                    <TextBlock x:Name="AvatarInitial" Text="" FontSize="20" FontWeight="Bold"
                                               Foreground="#FF1493" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- MESSAGES AREA -->
                    <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                                  Padding="20,10" Background="#0D0D0D">
                        <StackPanel x:Name="MessagesPanel" Margin="0,4"/>
                    </ScrollViewer>

                    <!-- TYPING INDICATOR -->
                    <Border Grid.Row="2" Background="#0D0D0D" Padding="26,0,0,0">
                        <TextBlock x:Name="TypingIndicator" Text="" FontSize="12" FontFamily="Consolas"
                                   Foreground="#FF1493" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Border>

                    <!-- INPUT AREA -->
                    <Border Grid.Row="3" Background="#111" BorderBrush="#1C1C1C" BorderThickness="0,1,0,0" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="10" Background="#1A1A1A"
                                    BorderBrush="#FF1493" BorderThickness="1.5" Padding="14,0" Margin="0,0,12,0">
                                <Grid>
                                    <TextBlock x:Name="PlaceholderText" Text="Type a message..."
                                               Foreground="#666" FontSize="14" FontFamily="Consolas"
                                               VerticalAlignment="Center" Padding="2,0,0,0" IsHitTestVisible="False"/>
                                    <TextBox x:Name="InputBox" Background="Transparent" BorderThickness="0"
                                             Foreground="White" CaretBrush="#FF1493" FontSize="14"
                                             FontFamily="Consolas" VerticalContentAlignment="Center"
                                             KeyDown="InputBox_KeyDown" TextChanged="InputBox_TextChanged"/>
                                </Grid>
                            </Border>
                            <Button x:Name="BtnSend" Grid.Column="1" Content="SEND" Width="90" Height="50"
                                    Style="{StaticResource SendButtonStyle}" Click="BtnSend_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- SIDEBAR - Did You Know scrolls with content -->
            <Border Grid.Column="1" Background="#0A0A0F" BorderBrush="#1A1A1A" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="15,20,15,20">
                        <!-- Header -->
                        <Border Background="#FF1493" CornerRadius="15" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🕐" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="HISTORY CHATS" FontSize="14" FontWeight="Bold" FontFamily="Consolas" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <!-- Recycle Bin - Visible Clickable Button with Counter -->
                        <Border Background="#1A1A2E" 
        CornerRadius="10" 
        Padding="12,10" 
        Margin="0,0,0,10" 
        Cursor="Hand"
        BorderBrush="#FF1493"
        BorderThickness="1.5"
        MouseLeftButtonDown="RecycleBinButton_Click"
        x:Name="RecycleBinBorder">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1A1A2E"/>
                                    <Setter Property="BorderBrush" Value="#FF1493"/>
                                    <Setter Property="BorderThickness" Value="1.5"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2A1A3E"/>
                                            <Setter Property="BorderBrush" Value="#FF66B2"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Recycle Bin Icon -->
                                <TextBlock Grid.Column="0" Text="🗑️" FontSize="18" Foreground="#FF66B2" 
                   Margin="0,0,10,0" VerticalAlignment="Center"/>

                                <!-- Text -->
                                <TextBlock Grid.Column="1" Text="VIEW RECYCLE BIN" FontSize="13" FontWeight="Bold" 
                   FontFamily="Consolas" Foreground="#FF66B2" VerticalAlignment="Center"/>

                                <!-- Counter Badge -->
                                <Border Grid.Column="2" 
                Background="#FF1493" 
                CornerRadius="12" 
                Padding="8,2,8,2" 
                Margin="10,0,0,0" 
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                x:Name="RecycleBinCounter"
                Visibility="Visible">
                                    <TextBlock x:Name="RecycleBinCountText" 
                       Text="0" 
                       FontSize="11" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       FontFamily="Consolas"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Height="1" Background="#FF1493" Opacity="0.2" Margin="0,5,0,10"/>

                        <!-- Favorites Panel -->
                        <StackPanel x:Name="FavoritesPanel"/>

                        <!-- Did You Know - Scrolls with content -->
                        <Border Background="#1A1A2E" CornerRadius="10" Padding="12" Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="💡 DID YOU KNOW?" FontSize="12" FontWeight="Bold" 
                                           Foreground="#FF1493" FontFamily="Consolas"/>
                                <Border Background="#0D0D0D" CornerRadius="8" Padding="10,8" Margin="0,6,0,0">
                                    <TextBlock x:Name="DidYouKnowText" 
                                               Text="Cybersecurity is everyone's responsibility!"
                                               FontSize="11" 
                                               Foreground="#888" 
                                               FontFamily="Consolas" 
                                               TextWrapping="Wrap" 
                                               TextAlignment="Left"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Rectangle x:Name="DarkOverlay" Fill="#B3000000" Visibility="Collapsed"/>

        <!-- LOGIN PANEL -->
        <Border x:Name="LoginPanel" Width="850" Height="500" CornerRadius="20"
                Background="#0A0813" BorderBrush="#FF1493" BorderThickness="1.5"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                ClipToBounds="True" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="28,0,0,25">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#050308" Offset="0.0"/>
                            <GradientStop Color="#12061C" Offset="0.5"/>
                            <GradientStop Color="#07040D" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Border Width="240" Height="150" CornerRadius="16" HorizontalAlignment="Left"
                            VerticalAlignment="Top" Background="#110B1E" BorderThickness="1"
                            BorderBrush="#33FF1493" Margin="28,145,0,0">
                        <StackPanel VerticalAlignment="Center" Margin="15,0,15,0">
                            <Border x:Name="BorderLoginTab" CornerRadius="10"
                                    Background="#25FF1493" BorderBrush="#AAFF1493" BorderThickness="1.5"
                                    Padding="15,12" Margin="0,6" Cursor="Hand" MouseDown="BtnToggleMode_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                        <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" Fill="#FF1493"/>
                                    </Viewbox>
                                    <TextBlock x:Name="TxtSidebarLogin" Text="LOGIN"
                                               FontWeight="Bold" Foreground="White" FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="BorderRegisterTab" CornerRadius="10" Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="1" Padding="15,12" Margin="0,6"
                                    Cursor="Hand" MouseDown="BtnToggleMode_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                        <Path Data="M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M6,10V7H4V10H1V12H4V15H6V12H9V10M15,12A4,4 0 0,0 19,8A4,4 0 0,0 15,4A4,4 0 0,0 11,8A4,4 0 0,0 15,12Z" Fill="#5A5375"/>
                                    </Viewbox>
                                    <TextBlock x:Name="TxtSidebarRegister" Text="SIGN UP"
                                               FontWeight="SemiBold" Foreground="#5A5375" FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" Margin="55,30,55,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtHeader" Text="LOGIN PAGE" FontSize="24" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,15"/>

                    <Border Grid.Row="1" x:Name="StatusBorder" Visibility="Collapsed" CornerRadius="8"
                            Padding="12,8" Margin="0,0,0,15" Background="#33FF1493"
                            BorderBrush="#FF1493" BorderThickness="1">
                        <TextBlock x:Name="TxtStatus" TextAlignment="Center" FontSize="12"
                                   Foreground="#FFA3B1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Username" Foreground="#A29DB0" FontSize="13" Margin="2,0,0,6"/>
                            <Border CornerRadius="10" Background="#110E1F" BorderBrush="#FF1493"
                                    BorderThickness="1.2" Height="44" Padding="12,0">
                                <TextBox x:Name="TxtUsername" Background="Transparent" BorderThickness="0"
                                         Foreground="White" CaretBrush="White" FontSize="14"
                                         VerticalContentAlignment="Center" TextChanged="TxtUsername_TextChanged"/>
                            </Border>
                            <TextBlock x:Name="ErrorUsername" Foreground="#FF5C5C" FontSize="11" Margin="4,4,0,14"/>

                            <TextBlock Text="Password" Foreground="#A29DB0" FontSize="13" Margin="2,0,0,6"/>
                            <Border CornerRadius="10" Background="#110E1F" BorderBrush="#FF1493"
                                    BorderThickness="1.2" Height="44" Padding="12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="TxtPassword" Background="Transparent"
                                                 BorderThickness="0" CaretBrush="#FF1493"
                                                 VerticalContentAlignment="Center" FontSize="14"
                                                 Foreground="White" PasswordChanged="TxtPassword_PasswordChanged"/>
                                    <TextBox x:Name="TxtPasswordUnmasked" Visibility="Collapsed"
                                             Background="Transparent" BorderThickness="0" Foreground="White"
                                             CaretBrush="#FF1493" FontSize="14" VerticalContentAlignment="Center"
                                             TextChanged="TxtPasswordUnmasked_TextChanged"/>
                                    <Button x:Name="BtnTogglePassword" Grid.Column="1"
                                            Style="{StaticResource EyeButtonStyle}" Click="BtnTogglePassword_Click">
                                        <Viewbox Width="16" Height="16">
                                            <Path Data="M12,9A3,3 0 0,1 9,12A3,3 0 0,1 12,15A3,3 0 0,1 15,12A3,3 0 0,1 12,9M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17C9.33,17 7,14.67 7,12C7,9.33 9.33,7 12,7C14.67,7 17,9.33 17,12C17,14.67 14.67,17 12,17Z" Fill="#FF1493"/>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="ErrorPassword" Foreground="#FF5C5C" FontSize="11" Margin="4,4,0,5"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="3" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtFooterPrompt" Text="Don't have an account? "
                                       Foreground="#6C6682" FontSize="13"/>
                            <Button x:Name="BtnToggleMode" Content="Register here"
                                    Style="{StaticResource LinkButtonStyle}" Click="BtnToggleMode_Click"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnSubmit" Content="LOGIN" Width="140"
                                Height="44" Style="{StaticResource SubmitButtonStyle}" Click="BtnSubmit_Click"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>